# Sub-repos (managed separately, cloned via syncing-repos skill)
repos/*
!repos/repos.json.example

# Git worktrees (created per parallel worker by epic workflow)
trees/

# Temporary agent work files
.tmp/

# Working artifacts — plans, research, and reports are LOCAL ONLY.
# They are often about other projects and must never ship in this public harness repo.
# Only the directory structure, the storage contract docs, and test fixtures are tracked.
plans/drafts/*
!plans/drafts/.gitkeep
!plans/drafts/test-plan-review.md
plans/committed/*
!plans/committed/.gitkeep
!plans/committed/test-plan-review.md
plans/research/*
!plans/research/.gitkeep
reports/*
!reports/.gitkeep

# Local-only: which plan the session is actively discussing (plan review auto-follow)
plans/session-context.json

# Per-repo knowledge files describe external projects, not the harness itself.
knowledge/repos/*.yaml
!knowledge/repos/.gitkeep

# Beads runtime files (Dolt backend)
.beads/*.db
.beads/*.db-wal
.beads/*.db-shm
.beads/.daemon*
.beads/.dolt/
.beads/issues.jsonl
# Per-clone Beads identity — must NOT be shared across users.
# Each clone regenerates its own project_id via `bd init` / `bd doctor --fix`.
.beads/metadata.json

# Project-specific planning docs (live in their own sub-repos)
docs/plans/dnd-*.md

# Dashboard generated data
docs/data/beads.json

# Vite production build output (dashboard root is docs/)
docs/dist/

# Standard
node_modules/
.env
.env.local
.idea/
.vscode/
*.DS_Store

# Playwright MCP artifacts
.playwright-mcp/

# Bun lockfile (commit this if you want reproducible installs)
# bun.lockb

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
